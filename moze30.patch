From ad7495310ae33e1d17da52ec920b7659433731db Mon Sep 17 00:00:00 2001
From: moze30 <z834080913@163.com>
Date: Fri, 24 Apr 2026 13:39:16 +0000
Subject: [PATCH] app: Fix virtual gamepad controls freezing on multi-touch
 pointer release

---
 app/src/main/java/com/winlator/widget/InputControlsView.java | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)
 mode change 100644 => 100755 app/src/main/java/com/winlator/widget/InputControlsView.java

diff --git a/app/src/main/java/com/winlator/widget/InputControlsView.java b/app/src/main/java/com/winlator/widget/InputControlsView.java
old mode 100644
new mode 100755
index 19874de..0a8a538
--- a/app/src/main/java/com/winlator/widget/InputControlsView.java
+++ b/app/src/main/java/com/winlator/widget/InputControlsView.java
@@ -392,10 +392,11 @@ public boolean onTouchEvent(MotionEvent event) {
                     for (byte i = 0, count = (byte)event.getPointerCount(); i < count; i++) {
                         float x = event.getX(i);
                         float y = event.getY(i);
+                        int movePointerId = event.getPointerId(i);
 
                         handled = false;
                         for (ControlElement element : profile.getElements()) {
-                            if (element.handleTouchMove(i, x, y)) handled = true;
+                            if (element.handleTouchMove(movePointerId, x, y)) handled = true;
                         }
                         if (!handled) touchpadView.onTouchEvent(event);
                     }
